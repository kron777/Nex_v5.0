{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboticsentience.org/schemas/rdo.raw_objective.v1.schema.json",
  "title": "RDO raw objective v1",
  "description": "An immutable raw idea record before any seed obligations or planning cycle exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective_id",
    "raw_revision",
    "supersedes_raw_sha256",
    "original_text",
    "intent",
    "owner",
    "source",
    "scope",
    "constraints",
    "exclusions",
    "assumptions",
    "acceptance_criteria",
    "max_depth"
  ],
  "properties": {
    "schema_version": {
      "const": "rdo.raw_objective.v1"
    },
    "objective_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "raw_revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_raw_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "external_llm",
            "imported"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "affected_paths"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "raw_revision": {
            "const": 1
          }
        },
        "required": [
          "raw_revision"
        ]
      },
      "then": {
        "properties": {
          "supersedes_raw_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_revision": {
            "minimum": 2
          }
        },
        "required": [
          "raw_revision"
        ]
      },
      "then": {
        "properties": {
          "supersedes_raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
