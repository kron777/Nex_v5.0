{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kron777/Nex_v5.0/blob/main/rdo/schemas/objective.v1.schema.json",
  "title": "RDO Objective Input v1",
  "description": "Provider-neutral, advisory objective intake. Input obligations are proposals; measured reconciliation and execution authority are never accepted from the payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective_id",
    "revision",
    "supersedes_sha256",
    "original_text",
    "intent",
    "owner",
    "source",
    "scope",
    "constraints",
    "exclusions",
    "assumptions",
    "acceptance_criteria",
    "seed_obligations",
    "relationships",
    "reconciliation_signatures",
    "max_depth"
  ],
  "properties": {
    "schema_version": {
      "const": "rdo.objective.v1"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "original_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "external_llm",
            "imported"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "affected_paths"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true
        },
        "affected_paths": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "$ref": "#/$defs/textList"
    },
    "exclusions": {
      "$ref": "#/$defs/textList"
    },
    "assumptions": {
      "$ref": "#/$defs/textList"
    },
    "acceptance_criteria": {
      "$ref": "#/$defs/nonEmptyTextList"
    },
    "seed_obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/seedObligation"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "reconciliation_signatures": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "seedObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "kind",
        "classification",
        "rationale",
        "impact",
        "evidence_needs",
        "assumptions",
        "confidence"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "classification": {
          "enum": [
            "necessary",
            "conditional",
            "optional",
            "future",
            "hypothesis",
            "unknown",
            "anti_requirement"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence_needs": {
          "$ref": "#/$defs/nonEmptyTextList"
        },
        "assumptions": {
          "$ref": "#/$defs/textList"
        },
        "confidence": {
          "enum": [
            "stated",
            "inferred"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "dst",
        "kind",
        "authority",
        "reversible",
        "note"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dst": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "depends_on",
            "produces_for",
            "reuses",
            "duplicates",
            "influences"
          ]
        },
        "authority": {
          "enum": [
            "none",
            "bounded",
            "strong"
          ]
        },
        "reversible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "path",
        "label"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "label": {
          "type": "string",
          "maxLength": 256
        }
      }
    }
  }
}
